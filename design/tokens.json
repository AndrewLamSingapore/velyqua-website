{
  "name": "VELYQUA design tokens",
  "version": "1.0.0",
  "description": "Canonical cross-surface tokens for the VELYQUA marketing site and AI platform. The marketing site consumes these via tailwind.config.ts; the app maps them in src/theme.ts.",
  "color": {
    "abyss": "#010A11",
    "deep": "#041523",
    "deep2": "#061B2D",
    "navy": "#062A4E",
    "midnight": "#0B2748",
    "teal": "#007F86",
    "cyan": "#00BFC7",
    "cyanGlow": "#4AF0E3",
    "cyanSoft": "#8FE8E1",
    "cyanPale": "#A5E9E5",
    "aqua": "#DDF6F3",
    "foam": "#F5FFFF",
    "mist": "#F4FBFB",
    "ink": "#EAF4F6",
    "muted": "#7A96A8",
    "line": "#12314B",
    "coral": "#D8624A",
    "amber": "#D79A24",
    "mint": "#EAF8F3",
    "cloud": "#F4F8F8",
    "inkLight": "#173042",
    "mutedLight": "#607786",
    "lineLight": "#D8E5E8",
    "white": "#FFFFFF"
  },
  "font": {
    "display": "Space Grotesk",
    "body": "Inter",
    "mono": "IBM Plex Mono",
    "serifAccent": "Instrument Serif"
  },
  "space": {
    "sectionDesktop": "8rem",
    "sectionMobile": "6rem",
    "gutterDesktop": "2.5rem",
    "gutterMobile": "1.5rem"
  },
  "radius": {
    "panel": "1rem",
    "device": "2rem",
    "pill": "9999px"
  },
  "motion": {
    "revealDuration": 1,
    "revealEase": "power3.out",
    "marqueeDuration": 34,
    "heroStagger": 0.12
  }
}
